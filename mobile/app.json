{
  "expo": {
    "name": "AI Trader",
    "slug": "ai-trader-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "androidStatusBar": {
      "backgroundColor": "#0b1220",
      "barStyle": "light-content",
      "translucent": false
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "./plugins/with-cleartext-traffic",
      [
        "expo-av",
        {
          "microphonePermission": "AI Trader uses the microphone so you can ask a question out loud instead of typing it."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.local.aitrader",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020611"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "58ca35af-2cf4-44a0-8da4-7f02563b635f"
      }
    },
    "owner": "nexuspay",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/58ca35af-2cf4-44a0-8da4-7f02563b635f"
    }
  }
}
